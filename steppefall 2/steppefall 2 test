# ============================================================
# WORLD → CAMERA SPACE
# ============================================================

def world_to_camera(
    point,
    camera_position
):

    point = pygame.Vector3(point)

    relative = (
        point -
        camera_position
    )

    # Camera forward direction.

    forward = pygame.Vector3(

        -math.cos(camera_pitch) *
        math.cos(camera_yaw),

        -math.cos(camera_pitch) *
        math.sin(camera_yaw),

        math.sin(camera_pitch)

    )

    forward.normalize()

    # World up.

    world_up = pygame.Vector3(
        0,
        0,
        1
    )

    # Camera right.

    right = forward.cross(
        world_up
    )

    if right.length_squared() == 0:

        right = pygame.Vector3(
            1,
            0,
            0
        )

    else:

        right.normalize()

    # Camera up.

    up = right.cross(
        forward
    )

    up.normalize()

    camera_x = relative.dot(
        right
    )

    camera_y = relative.dot(
        up
    )

    camera_z = relative.dot(
        forward
    )

    return pygame.Vector3(

        camera_x,
        camera_y,
        camera_z

    )


# ============================================================
# 3D → 2D PROJECTION
# ============================================================

FOCAL_LENGTH = 700

# Only used to prevent division by a number
# extremely close to zero.

NEAR_PLANE = 0.10


def project(
    point,
    camera_position
):

    camera_point = world_to_camera(

        point,
        camera_position

    )

    # Behind camera.

    if camera_point.z <= NEAR_PLANE:

        return None

    screen_x = (

        WIDTH / 2
        +
        camera_point.x /
        camera_point.z *
        FOCAL_LENGTH

    )

    screen_y = (

        HEIGHT / 2
        -
        camera_point.y /
        camera_point.z *
        FOCAL_LENGTH

    )

    return (

        pygame.Vector2(
            screen_x,
            screen_y
        ),

        camera_point.z

    )


# ============================================================
# CLIP POLYGON TO NEAR PLANE
# ============================================================

def clip_camera_polygon(
    points
):
    clipped = []
    previous = points[-1]
    previous_inside = previous.z > NEAR_PLANE
    for current in points:
        current_inside = current.z > NEAR_PLANE
        if current_inside != previous_inside:
            distance = current.z - previous.z
            if distance != 0:
                amount = (
                    NEAR_PLANE - previous.z
                ) / distance
                clipped.append(
                    previous + (current - previous) * amount
                )
        if current_inside:
            clipped.append(current)
        previous = current
        previous_inside = current_inside
    return clipped


def project_camera_point(
    camera_point
):
    screen_x = (
        WIDTH / 2
        + camera_point.x /
        camera_point.z *
        FOCAL_LENGTH
    )
    screen_y = (
        HEIGHT / 2
        - camera_point.y /
        camera_point.z *
        FOCAL_LENGTH
    )
    return pygame.Vector2(
        screen_x,
        screen_y
    )


# ============================================================
# GET CUBE VERTICES
# ============================================================

def get_cube_vertices(
    x,
    y,
    z
):

    vertices = []

    for vx, vy, vz in cube_vertices:

        vertices.append(

            pygame.Vector3(

                x + vx,
                y + vy,
                z + vz

            )

        )

    return vertices


# ============================================================
# FACE NORMAL
# ============================================================

def get_face_normal(
    vertices,
    face
):

    a = vertices[
        face[0]
    ]

    b = vertices[
        face[1]
    ]

    c = vertices[
        face[2]
    ]

    edge1 = b - a
    edge2 = c - a

    return edge1.cross(
        edge2
    )


# ============================================================
# DRAW WORLD
# ============================================================

def draw_world(
    camera_position
):

    faces_to_draw = []

    for (
        x,
        y,
        z
    ), block in world.items():

        vertices = get_cube_vertices(

            x,
            y,
            z

        )

        for (
            face_number,
            face
        ) in enumerate(
            cube_faces
        ):

            # ------------------------------------------------
            # Don't draw faces hidden inside another block.
            # ------------------------------------------------

            if face_number == 0:

                neighbour = (

                    x,
                    y,
                    z - 1

                )

            elif face_number == 1:

                neighbour = (

                    x,
                    y,
                    z + 1

                )

            elif face_number == 2:

                neighbour = (

                    x,
                    y - 1,
                    z

                )

            elif face_number == 3:

                neighbour = (

                    x + 1,
                    y,
                    z

                )

            elif face_number == 4:

                neighbour = (

                    x,
                    y + 1,
                    z

                )

            else:

                neighbour = (

                    x - 1,
                    y,
                    z

                )

            if neighbour in world:

                continue

            # ------------------------------------------------
            # Back-face culling
            # ------------------------------------------------

            normal = get_face_normal(

                vertices,
                face

            )

            centre = pygame.Vector3()

            for index in face:

                centre += vertices[
                    index
                ]

            centre /= 4

            to_camera = (

                camera_position -
                centre

            )

            if normal.dot(
                to_camera
            ) <= 0:

                continue

            # ------------------------------------------------
            # Clip faces that cross the near plane instead of
            # dropping the whole face at the screen edges.
            # ------------------------------------------------
            camera_points = []
            for index in face:
                camera_points.append(
                    world_to_camera(
                        vertices[index],
                        camera_position
                    )
                )
            camera_points = clip_camera_polygon(
                camera_points
            )
            if len(camera_points) < 3:
                continue
            projected_points = []
            depths = []
            for camera_point in camera_points:
                projected_points.append(
                    project_camera_point(
                        camera_point
                    )
                )
                depths.append(
                    camera_point.z
                )
            # ------------------------------------------------
            # Average depth
            # ------------------------------------------------
            average_depth = (
                sum(depths) /
                len(depths)
            )

            faces_to_draw.append(

                (

                    average_depth,
                    block,
                    face_number,
                    projected_points

                )

            )

    # ========================================================
    # FAR → NEAR
    # ========================================================

    faces_to_draw.sort(

        key=lambda item: item[0],
        reverse=True

    )

    # ========================================================
    # DRAW
    # ========================================================

    for (

        depth,
        block,
        face_number,
        points

    ) in faces_to_draw:

        colour = block_colours[
            block
        ][
            face_number
        ]

        pygame.draw.polygon(

            screen,
            colour,
            points

        )

        pygame.draw.polygon(

            screen,
            (35, 25, 15),
            points,
            1

        )


