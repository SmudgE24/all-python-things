# ============================================================
# PLAYER COLLISION
# ============================================================

def player_overlaps_block(
    position,
    block_position,
    allow_water=False
):

    half_width = (
        PLAYER_WIDTH / 2
    )

    player_min_x = (
        position.x -
        half_width
    )

    player_max_x = (
        position.x +
        half_width
    )

    player_min_y = (
        position.y -
        half_width
    )

    player_max_y = (
        position.y +
        half_width
    )

    player_min_z = position.z

    player_max_z = (

        position.z +
        PLAYER_HEIGHT

    )

    block_x, block_y, block_z = (
        block_position
    )

    # Allow passing through water if allow_water is True
    if allow_water and block_position in world and world[block_position] == "water":
        return False

    return (

        player_max_x > block_x
        and
        player_min_x < block_x + 1

        and

        player_max_y > block_y
        and
        player_min_y < block_y + 1

        and

        player_max_z > block_z
        and
        player_min_z < block_z + 1

    )


# ============================================================
# HORIZONTAL PLAYER MOVEMENT
# ============================================================

def move_player_horizontal(
    axis,
    amount
):

    global player

    new_position = player.copy()

    if axis == "x":

        new_position.x += amount

    else:

        new_position.y += amount

    half_width = (
        PLAYER_WIDTH / 2
    )

    min_x = (

        math.floor(

            new_position.x -
            half_width

        ) - 1

    )

    max_x = (

        math.floor(

            new_position.x +
            half_width

        ) + 1

    )

    min_y = (

        math.floor(

            new_position.y -
            half_width

        ) - 1

    )

    max_y = (

        math.floor(

            new_position.y +
            half_width

        ) + 1

    )

    min_z = (

        math.floor(
            new_position.z
        ) - 1

    )

    max_z = (

        math.floor(

            new_position.z +
            PLAYER_HEIGHT

        ) + 1

    )

    for x in range(
        min_x,
        max_x + 1
    ):

        for y in range(
            min_y,
            max_y + 1
    ):

            for z in range(
                min_z,
                max_z + 1
            ):

                if (
                    x,
                    y,
                    z
                ) not in world:

                    continue

                if player_overlaps_block(

                    new_position,
                    (x, y, z),
                    allow_water=True

                ):

                    return

    player = new_position


# ============================================================
# VERTICAL PLAYER MOVEMENT
# ============================================================

def move_player_vertical(
    amount
):

    global player
    global vertical_velocity
    global on_ground

    new_position = player.copy()

    new_position.z += amount

    half_width = (
        PLAYER_WIDTH / 2
    )

    min_x = (

        math.floor(

            new_position.x -
            half_width

        ) - 1

    )

    max_x = (

        math.floor(

            new_position.x +
            half_width

        ) + 1

    )

    min_y = (

        math.floor(

            new_position.y -
            half_width

        ) - 1

    )

    max_y = (

        math.floor(

            new_position.y +
            half_width

        ) + 1

    )

    min_z = (

        math.floor(
            new_position.z
        ) - 1

    )

    max_z = (

        math.floor(

            new_position.z +
            PLAYER_HEIGHT

        ) + 1

    )

    for x in range(
        min_x,
        max_x + 1
    ):

        for y in range(
            min_y,
            max_y + 1
        ):

            for z in range(
                min_z,
                max_z + 1
            ):

                if (
                    x,
                    y,
                    z
                ) not in world:

                    continue

                if player_overlaps_block(

                    new_position,
                    (x, y, z),
                    allow_water=True

                ):

                    # Falling.

                    if vertical_velocity <= 0:

                        player.z = (
                            z + 1
                        )

                        vertical_velocity = 0

                        on_ground = True

                        return

                    # Jumping into ceiling.

                    else:

                        player.z = (

                            z -
                            PLAYER_HEIGHT

                        )

                        vertical_velocity = 0

                        return

    player = new_position

    on_ground = False


# ============================================================
# CHECK IF PLAYER IN WATER
# ============================================================

def update_in_water():
    global in_water
    
    # Check if player's center is inside a water block
    player_block_x = int(player.x)
    player_block_y = int(player.y)
    player_block_z = int(player.z)
    
    # Check center of player
    if (player_block_x, player_block_y, player_block_z) in world:
        if world[(player_block_x, player_block_y, player_block_z)] == "water":
            in_water = True
            return
    
    # Check top of player
    player_block_z_top = int(player.z + PLAYER_HEIGHT)
    if (player_block_x, player_block_y, player_block_z_top) in world:
        if world[(player_block_x, player_block_y, player_block_z_top)] == "water":
            in_water = True
            return
    
    in_water = False


# ============================================================
# PLAYER PHYSICS
# ============================================================

def update_player_physics(
    dt
):

    global vertical_velocity
    global on_ground

    keys = pygame.key.get_pressed()

    movement = pygame.Vector3()

    # Player movement uses camera yaw.

    forward = pygame.Vector3(

        -math.cos(camera_yaw),
        -math.sin(camera_yaw),
        0

    )

    right = pygame.Vector3(

        -math.sin(camera_yaw),
        math.cos(camera_yaw),
        0

    )

    if keys[pygame.K_w]:

        movement += forward

    if keys[pygame.K_s]:

        movement -= forward

    if keys[pygame.K_d]:

        movement += right

    if keys[pygame.K_a]:

        movement -= right

    if movement.length_squared() > 0:

        movement.normalize()

        move_player_horizontal(

            "x",

            movement.x *
            PLAYER_SPEED *
            dt

        )

        move_player_horizontal(

            "y",

            movement.y *
            PLAYER_SPEED *
            dt

        )

    # Jump.

    if (
        keys[pygame.K_SPACE]
        and
        on_ground
    ):

        vertical_velocity = (
            JUMP_SPEED
        )

        on_ground = False

    # Gravity.

    vertical_velocity += (

        GRAVITY *
        dt

    )

    move_player_vertical(

        vertical_velocity *
        dt

    )

    # Update water state
    update_in_water()

    # Respawn.

    if player.z < -20:

        player.update(
            spawn_position
        )

        vertical_velocity = 0

        on_ground = False


# ============================================================
# CAMERA COLLISION
# ============================================================

def camera_overlaps_block(
    position,
    block_position
):
    """Check if camera overlaps with a solid block (not water)"""
    # Camera is a point, use small radius for collision
    camera_radius = 0.3
    
    block_x, block_y, block_z = block_position
    
    # Check if camera is inside block bounds
    if (position.x > block_x - camera_radius and
        position.x < block_x + 1 + camera_radius and
        position.y > block_y - camera_radius and
        position.y < block_y + 1 + camera_radius and
        position.z > block_z - camera_radius and
        position.z < block_z + 1 + camera_radius):
        return True
    return False


def move_camera_with_collision(
    new_position
):
    """Move camera while checking for block collisions"""
    # Check nearby blocks
    min_x = math.floor(new_position.x) - 1
    max_x = math.floor(new_position.x) + 1
    min_y = math.floor(new_position.y) - 1
    max_y = math.floor(new_position.y) + 1
    min_z = math.floor(new_position.z) - 1
    max_z = math.floor(new_position.z) + 1
    
    for x in range(min_x, max_x + 1):
        for y in range(min_y, max_y + 1):
            for z in range(min_z, max_z + 1):
                if (x, y, z) not in world:
                    continue
                # Water blocks don't collide with camera
                if world[(x, y, z)] == "water":
                    continue
                if camera_overlaps_block(new_position, (x, y, z)):
                    return False
    
    return True


# ============================================================
# THIRD-PERSON CAMERA
# ============================================================

def update_third_person_camera(
    dt
):

    global third_person_camera

    keys = pygame.key.get_pressed()

    movement = pygame.Vector3()

    # Camera horizontal forward.

    forward = pygame.Vector3(

        -math.cos(camera_yaw),
        -math.sin(camera_yaw),
        0

    )

    # Camera horizontal right.

    right = pygame.Vector3(

        -math.sin(camera_yaw),
        math.cos(camera_yaw),
        0

    )

    if keys[pygame.K_w]:

        movement += forward

    if keys[pygame.K_s]:

        movement -= forward

    if keys[pygame.K_d]:

        movement += right

    if keys[pygame.K_a]:

        movement -= right

    # Vertical camera movement.

    if keys[pygame.K_SPACE]:

        movement.z += 1

    if keys[pygame.K_LSHIFT]:

        movement.z -= 1

    if movement.length_squared() > 0:

        movement.normalize()
        
        new_camera_pos = third_person_camera + (
            movement *
            CAMERA_SPEED *
            dt
        )
        
        # Check collision with blocks
        if move_camera_with_collision(new_camera_pos):
            third_person_camera = new_camera_pos

    # Keep camera at/inside world edges.

    CAMERA_MARGIN = 0.05

    third_person_camera.x = max(

        -CAMERA_MARGIN,

        min(

            WORLD_SIZE +
            CAMERA_MARGIN,

            third_person_camera.x

        )

    )

    third_person_camera.y = max(

        -CAMERA_MARGIN,

        min(

            WORLD_SIZE +
            CAMERA_MARGIN,

            third_person_camera.y

        )

    )

    third_person_camera.z = max(

        -CAMERA_MARGIN,

        min(

            WORLD_SIZE +
            CAMERA_MARGIN,

            third_person_camera.z

        )

    )


