        "RIGHT MOUSE + DRAG = Look",

        f"Time: {(pygame.time.get_ticks() - start_time) / 1000}s",

        f"Player: "
        f"{player.x:.1f}, "
        f"{player.y:.1f}, "
        f"{player.z:.1f}",

        f"Camera: "
        f"{third_person_camera.x:.1f}, "
        f"{third_person_camera.y:.1f}, "
        f"{third_person_camera.z:.1f}",

        "World: 10 x 10 x 10"

    ]

    y = 15

    for text in information:

        image = font.render(

            text,
            True,
            (240, 240, 240)

        )

        screen.blit(

            image,
            (15, y)

        )

        y += 25


# ============================================================
# MAIN LOOP
# ============================================================

running = True

while running:

    dt = (
        clock.tick(60) /
        1000
    )

    # ========================================================
    # EVENTS
    # ========================================================

    for event in pygame.event.get():

        if event.type == pygame.QUIT:

            running = False

        # ====================================================
        # WINDOW RESIZE
        # ====================================================

        if event.type == pygame.VIDEORESIZE:

            WIDTH = event.w
            HEIGHT = event.h
            screen = pygame.display.set_mode((WIDTH, HEIGHT), pygame.RESIZABLE)

        # ====================================================
        # KEYBOARD
        # ====================================================

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:

                running = False

            # Switch camera mode.
            if event.key == pygame.K_F5:
                first_person = (
                    not first_person
                )
                # Put the independent camera near
                # the player when entering third person.
                if not first_person:
                    third_person_camera = (
                        player.copy()
                    )
                    third_person_camera.x += 5
                    third_person_camera.y += 5
                    third_person_camera.z += 4
                    # Keep it inside the world.
                    third_person_camera.x = max(
                        0,
                        min(
                            WORLD_SIZE,
                            third_person_camera.x
                        )
                    )
                    third_person_camera.y = max(
                        0,
                        min(
                            WORLD_SIZE,
                            third_person_camera.y
                        )
                    )
                    third_person_camera.z = max(
                        0,
                        min(
                            WORLD_SIZE,
                            third_person_camera.z
                        )
                    )

        # ====================================================
        # MOUSE BUTTON
        # ====================================================

        if event.type == pygame.MOUSEBUTTONDOWN:

            if event.button == 3:

                mouse_dragging = True

                last_mouse_position = pygame.Vector2(
                    event.pos
                )

        if event.type == pygame.MOUSEBUTTONUP:

            if event.button == 3:

                mouse_dragging = False

        # ====================================================
        # CAMERA LOOK
        # ====================================================

        if (
            event.type ==
            pygame.MOUSEMOTION
            and
            mouse_dragging
        ):

            current_mouse = pygame.Vector2(
                event.pos
            )

            movement = (
                current_mouse -
                last_mouse_position
            )

            last_mouse_position = (
                current_mouse
            )

            camera_yaw -= (
                movement.x *
                0.008
            )

            camera_pitch -= (
                movement.y *
                0.008
            )

            # Allow looking almost completely up/down.

            camera_pitch = max(

                math.radians(-75),
                min(
                    math.radians(75),
                    camera_pitch

                )

            )

    # ========================================================
    # UPDATE
    # ========================================================

    if first_person:

        # WASD controls player.

        update_player_physics(
            dt
        )

    else:

        # WASD controls ONLY camera.

        update_third_person_camera(
            dt
        )

    time = (pygame.time.get_ticks() - start_time) / 1000

    # ========================================================
    # DRAW
    # ========================================================

    cycle_time = time % 1200

    if cycle_time < 300:
        screen.fill((0, 234, 255))
        day = True

    elif cycle_time < 360:
        screen.fill((0, 0, 255))
        day = True

    elif cycle_time < 780:
        screen.fill((18, 22, 30))
        day = False

    elif cycle_time < 840:
        screen.fill((0, 0, 255))
        day = False

    else:
        screen.fill((0, 234, 255))
        day = True
                
    #(18, 22, 30)
    camera_position = (
        get_camera_position()
    )

    draw_world(
        camera_position
    )

    # Player is visible in third person.
    if not first_person:

        draw_player(
            camera_position
        )

    # Apply blue tint when in water
    if in_water:
        water_surface = pygame.Surface((WIDTH, HEIGHT))
        water_surface.set_alpha(80)
        water_surface.fill((30, 100, 200))
        screen.blit(water_surface, (0, 0))

    draw_ui()

    pygame.display.flip()

pygame.quit()